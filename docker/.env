PGADMIN_PASSWORD=admin123

DATASOURCE_URL_BOOKING=jdbc:postgresql://postgres-ms:5432/bookingdb
DATASOURCE_URL_MOVIE=jdbc:postgresql://postgres-ms:5432/moviedb
